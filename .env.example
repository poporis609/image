# Database Configuration
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_password_here

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# S3 Configuration
S3_BUCKET=your-s3-bucket

# Bedrock Model (Nova Canvas)
BEDROCK_MODEL_ID=amazon.nova-canvas-v1:0

# Bedrock LLM for Prompt Generation (Claude)
# 한글 일기를 영어 이미지 프롬프트로 변환하는 데 사용
# Cross-region inference profile 사용 (us. 접두사)
BEDROCK_LLM_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# Bedrock Flow Configuration
BEDROCK_FLOW_ID=your_flow_id_here
BEDROCK_FLOW_ALIAS_ID=your_flow_alias_id_here

# Knowledge Base S3 Bucket
KNOWLEDGE_BASE_BUCKET=your-knowledge-base-bucket
